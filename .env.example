# Application Core
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-relay-otp-2025

# Database Connection (Auto-injected by Railway PostgreSQL Plugin; leave empty for SQLite fallback)
DATABASE_URL=

# Cryptographic Master Key for Gmail App Passwords (AES-256 Fernet)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# IMAP Network Constraints
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_TIMEOUT_SECONDS=8
MAX_EMAILS_PER_FETCH=7
